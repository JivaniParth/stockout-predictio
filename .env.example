# HSCM Prediction Platform Environment Configuration Template
# Copy this file to .env and fill in real values. Never commit .env to version control!

# Service Ports & Runtime
PORT=8000
DEVICE=cpu
ENVIRONMENT=production

# Database & Cache Configurations
DATABASE_URL=postgresql://hscm_admin:change_me_secure_pass@localhost:5432/hscm_db
POSTGRES_DB=hscm_db
POSTGRES_USER=hscm_admin
POSTGRES_PASSWORD=change_me_secure_pass

REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=change_me_redis_secret

# Grafana Dashboard Credentials
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change_me_grafana_pass

# Cloudflare R2 / S3 Storage Credentials (Optional, for remote artifact storage)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hscm-model-artifacts
CLOUDFLARE_ACCOUNT_ID=

# Remote Managed Services (Optional, for Serverless Cloud Deployment)
UPSTASH_REDIS_URL=
NEON_DATABASE_URL=
DAGSHUB_MLFLOW_URI=
